<mxCell id="legend" value="PGCP — DER (introspecção do PostgreSQL, migrations 001–020). PK=chave primária, FK=estrangeira, NN=NOT NULL, UQ=UNIQUE (coluna única). Aresta: rótulo=ON DELETE; pé-de-galinha no lado N, barra no lado 1. UNIQUE compostos/parciais e gatilhos: ver painéis inferiores." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=2;fontColor=#334;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1600" height="24" as="geometry"/></mxCell>
<mxCell id="n271" value="&lt;b&gt;Índices UNIQUE (constraints + índices parciais reais)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;governance_bodies&lt;/b&gt; — (name)&lt;br&gt;&lt;b&gt;agenda_topic_types&lt;/b&gt; — (name)&lt;br&gt;&lt;b&gt;agenda_topic_natures&lt;/b&gt; — (name)&lt;br&gt;&lt;b&gt;meeting_notes&lt;/b&gt; — (meeting_id) — 1:1 com meetings&lt;br&gt;&lt;b&gt;meeting_minutes&lt;/b&gt; — (meeting_id) — 1:1 com meetings&lt;br&gt;&lt;b&gt;meeting_agenda_items&lt;/b&gt; — (meeting_id, id); (meeting_id, position) DEFERRABLE&lt;br&gt;&lt;b&gt;users&lt;/b&gt; — (entra_tenant_id, entra_object_id) WHERE entra NOT NULL [parcial]&lt;br&gt;&lt;b&gt;meeting_participants&lt;/b&gt; — (meeting_id,user_id) WHERE user_id NOT NULL; (meeting_id,entra_tenant_id,entra_object_id) WHERE entra; (meeting_id,lower(email)) WHERE convidado [parciais]&lt;br&gt;&lt;b&gt;agenda_topic_participants&lt;/b&gt; — (agenda_topic_id,user_id) WHERE user; (agenda_topic_id,entra..) WHERE entra; (agenda_topic_id,lower(email)) WHERE convidado [parciais]&lt;br&gt;&lt;b&gt;agenda_topics&lt;/b&gt; — (source_meeting_id, source_agenda_item_id) WHERE ambos NOT NULL [parcial]&lt;br&gt;&lt;b&gt;meeting_agenda_item_presenters&lt;/b&gt; — (meeting_agenda_item_id) WHERE is_lead — 1 relator principal por item [parcial]&lt;br&gt;&lt;b&gt;meeting_calendar_integrations&lt;/b&gt; — (meeting_id, provider); (provider, idempotency_key); (provider, provider_event_id) WHERE provider_event_id NOT NULL&lt;br&gt;&lt;b&gt;meeting_minute_signature_processes&lt;/b&gt; — (meeting_minute_id) WHERE status IN (prepared,in_progress) — 1 processo ativo por ata [parcial]&lt;br&gt;&lt;b&gt;meeting_minute_signers&lt;/b&gt; — (process,user_id) WHERE user; (process,entra..) WHERE entra; (process,lower(email)) WHERE convidado [parciais]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF8E1;strokeColor=#E0C36A;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1546" width="1180" height="460" as="geometry"/></mxCell>
<mxCell id="n272" value="&lt;b&gt;Gatilhos de integridade (além de 15× set_updated_at BEFORE UPDATE)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;action_items&lt;/b&gt; — origin_pairing — CONSTRAINT TRIGGER DEFERRED: valida par (origin_meeting_id, origin_agenda_item_id)&lt;br&gt;&lt;b&gt;meetings&lt;/b&gt; — freeze_online_provider — BEFORE UPDATE OF online_meeting_provider: congela provedor após definido&lt;br&gt;&lt;b&gt;meeting_minutes&lt;/b&gt; — block_content_while_signing — BEFORE UPDATE OF content: bloqueia edição durante assinatura&lt;br&gt;&lt;b&gt;meeting_minute_signature_processes&lt;/b&gt; — precondition + check_evidence (BEFORE INSERT); guard_update (BEFORE UPDATE)&lt;br&gt;&lt;b&gt;meeting_minute_signers&lt;/b&gt; — guard_insert / guard_delete / guard_update — protege o roster de assinantes" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF8E1;strokeColor=#E0C36A;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="1546" width="1080" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>