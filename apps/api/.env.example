# Modelo de configuracao da API. Copie para .env e ajuste os valores.
# O .env real NAO deve ser versionado nem exposto ao frontend.

# Porta HTTP em que a API escuta. Padrao: 3333.
PORT=3333

# Origens permitidas no CORS, separadas por virgula. Nunca usar "*".
# Padrao: http://localhost:3000 (frontend em desenvolvimento).
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL ---
# Em desenvolvimento local o banco sobe via infra/docker-compose.yml, que le
# estas variaveis deste arquivo.
# A API nao depende do Docker: qualquer PostgreSQL padrao atende.
#
# MENOR PRIVILEGIO — TRES papeis distintos (Achado A da auditoria):
#   DB_BOOTSTRAP_USER  superusuario de bootstrap do cluster. So inicializa o
#                      cluster e provisiona os outros papeis. A aplicacao e as
#                      migrations NUNCA usam esta credencial.
#   DB_MIGRATION_USER  papel de migration/dono (pcgp_admin). Sem superusuario.
#                      Roda `npm run db:migrate`. Dono das tabelas.
#   DB_USER            papel de RUNTIME da API (pcgp_app). NOSUPERUSER e sem
#                      nenhum atributo administrativo; so o DML necessario.
DB_HOST=localhost
# 5434 no dev local para nao colidir com outros PostgreSQL desta maquina.
DB_PORT=5434
DB_NAME=pcgp

# Runtime da API (menor privilegio).
DB_USER=pcgp_app
# Defina uma senha propria. Nunca preencha com a credencial real neste arquivo.
DB_PASSWORD=defina-uma-senha-local

# Migration/dono. Distinto do runtime: roda as migrations (DDL + grants).
DB_MIGRATION_USER=pcgp_admin
DB_MIGRATION_PASSWORD=defina-uma-senha-de-migration

# Bootstrap/superusuario do cluster. Usado so pelo docker-compose (POSTGRES_USER)
# para inicializar e provisionar. Nunca pela API.
DB_BOOTSTRAP_USER=pcgp_bootstrap
DB_BOOTSTRAP_PASSWORD=defina-uma-senha-de-bootstrap

# true apenas quando o servidor exigir TLS (ambientes gerenciados).
DB_SSL=false


# =============================================================================
# INTEGRACOES — PGCP CONECTADO
#
# Todas as integracoes abaixo aparecem em Configuracoes -> Integracoes, mesmo
# quando vazias: o painel mostra "Nao configurado" em vez de esconder.
#
# Deixar vazio e valido. Nenhuma variavel abaixo e obrigatoria para a aplicacao
# subir; sem elas as integracoes ficam inativas e o painel diz exatamente isso.
#
# SEGREDOS ficam SO neste arquivo, lido apenas pela API. Nunca replicar segredo
# em variavel VITE_*: tudo com esse prefixo e embutido no bundle do browser.
# =============================================================================


# --- Microsoft Entra ID (identidade corporativa / SSO) ---
#
# DOIS App Registrations no MESMO tenant:
#
#   PGCP Web / SPA  public client, sem secret, PKCE. Adquire o access token.
#   PGCP API        confidential client. Expoe o scope e valida o token.
#
# Nao confundir os dois client ids: o do SPA e validado como `azp`, o da API
# como `aud`. Trocar um pelo outro faz todo token ser rejeitado.

# Tenant unico dos dois registros. Define o `iss` e o claim `tid` aceitos.
ENTRA_TENANT_ID=

# Client id da PGCP API. E o `aud` esperado no access token v2.
ENTRA_API_CLIENT_ID=

# Client id do PGCP Web. E o `azp` esperado: somente este cliente pode obter
# token para esta API. Com mais clientes, isto vira uma allowlist.
ENTRA_SPA_CLIENT_ID=

# Application ID URI da API (api://<ENTRA_API_CLIENT_ID>).
# Serve para montar o scope no frontend e para documentacao.
# NUNCA e aceito como `aud` — o token v2 traz o client id, nao a URI.
ENTRA_API_APP_ID_URI=

# Nome do scope delegado exigido em `scp`. Padrao: access_as_user
ENTRA_API_SCOPE_NAME=access_as_user

# Secret da PGCP API. NAO e necessario para validar token: o JWKS e publico.
# Passa a ser exigido no fluxo On-Behalf-Of (Etapa 5). Deixe vazio ate la.
ENTRA_API_CLIENT_SECRET=

# --- Microsoft Graph ---
# Opcional. Padrao: https://graph.microsoft.com/v1.0
GRAPH_BASE_URL=

# --- E-mail (Graph Mail) ---
# Caixa remetente institucional. E-mail operacional (lembrete, cobranca) —
# o convite da reuniao continua sendo evento do Outlook, nao e-mail avulso.
MAIL_SENDER_ADDRESS=

# --- Locais fisicos de reuniao presencial ---
# DEPRECIADA desde a migration 038: a API nao le mais esta variavel. Os locais
# (nome e endereco) sao cadastrados em Administracao -> Locais. Pode ser removida.
# MEETING_LOCATIONS_ADDRESSES=

# --- DocuSign eSignature ---
# Demo:     account-d.docusign.com  /  https://demo.docusign.net/restapi
# Producao: account.docusign.com    /  https://<region>.docusign.net/restapi
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
# Necessaria apenas no Authorization Code Grant.
DOCUSIGN_REDIRECT_URI=

# --- Observabilidade tecnica ---
# Application Insights. Contem InstrumentationKey, portanto e tratada como
# segredo e nunca chega ao frontend.
# NAO confundir com a auditoria funcional, que vive na tabela audit_logs.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Documentos (AWS S3, bucket PRIVADO) ---
# Bytes no S3; metadados e autorizacao no PostgreSQL. Sem bucket/regiao, so as
# operacoes de arquivo respondem 503 (em producao o guard exige os dois).
# Credenciais: cadeia padrao do AWS SDK (IAM Role em producao; perfil/variaveis
# AWS_* so no ambiente local). NUNCA coloque chave de acesso neste arquivo.
PGCP_DOCUMENTS_BUCKET=
AWS_REGION=
# Opcional: chave KMS gerenciada pelo cliente (senao, SSE-S3).
PGCP_DOCUMENTS_KMS_KEY_ID=
# Opcional: tamanho maximo do arquivo em bytes (padrao 20971520 = 20 MB).
DOCUMENT_MAX_SIZE_BYTES=
