# =============================================================================
# Configuracao do frontend (apps/web).
#
# REGRA: tudo com prefixo VITE_ e EMBUTIDO no bundle e fica visivel a qualquer
# pessoa que abrir o navegador. Portanto:
#
#   AQUI  -> apenas configuracao PUBLICA
#   NUNCA -> client secret, senha, token, chave privada, connection string
#
# Segredo pertence a apps/api/.env, que so a API le.
# =============================================================================

# URL base da API do PGCP (apps/api).
# Opcional: quando ausente, o frontend usa http://localhost:3333.
# Toda chamada passa por src/lib/api.ts — nao repetir a URL em componentes.
VITE_API_URL=http://localhost:3333


# --- Microsoft Entra ID (login real, Etapa 2) --------------------------------
# Valores publicos por natureza: o MSAL roda no browser e precisa deles para
# montar a requisicao de autorizacao.
#
# Enquanto vazios, a aplicacao continua com o login local de desenvolvimento.

# Tenant unico. Mesmo valor de ENTRA_TENANT_ID em apps/api/.env.
VITE_ENTRA_TENANT_ID=

# Client id do App Registration do PGCP Web (SPA).
# ATENCAO: NAO e o client id da API. Sao dois registros distintos — este e
# validado pela API como `azp`, e corresponde a ENTRA_SPA_CLIENT_ID.
VITE_ENTRA_SPA_CLIENT_ID=

# Redirect URI registrada no App Registration, plataforma "Single-page
# application". Precisa bater EXATAMENTE, incluindo porta e caminho.
#
# Aponta para a ponte de redirect (apps/web/auth/redirect.html), NAO para a raiz
# da aplicacao. No MSAL Browser v5 o popup aguarda a resposta num
# BroadcastChannel publicado por `broadcastResponseToMainFrame()`; se o Entra
# devolver o code para "/", o popup carrega o PGCP inteiro, ninguem publica no
# canal e o login expira com `timed_out`.
#
# A pagina e servida como arquivo estatico, entao a mesma URL vale em dev,
# preview e build — sem rewrite no servidor.
VITE_ENTRA_REDIRECT_URI=http://localhost:3000/auth/redirect.html

# Scope COMPLETO que o MSAL pede para falar com a API do PGCP:
#   api://<ENTRA_API_CLIENT_ID>/access_as_user
# Note que aqui entra o client id da API, nao o do SPA.
VITE_ENTRA_API_SCOPE=

# NAO adicionar secret aqui. Tudo com prefixo VITE_ vai para o bundle do
# navegador; o fluxo do MSAL em SPA usa PKCE, que dispensa segredo no cliente.


# --- Modo de teste (transitorio) ---------------------------------------------
# Perfis mockados na tela de login, para desenvolvimento sem Entra.
#
# O modo de teste SOME automaticamente quando as tres variaveis VITE_ENTRA_*
# acima estao preenchidas: os dois caminhos nunca coexistem, entao ligar o Entra
# ja remove o bypass sem depender de ninguem desligar esta flag.
#
# "false" desliga o modo de teste tambem em ambiente sem Entra — util para
# confirmar que a aplicacao nao tem caminho alternativo de entrada.
#
# Deve ser REMOVIDA junto com o login mock assim que o fluxo Entra for validado.
VITE_ALLOW_MOCK_LOGIN=true
